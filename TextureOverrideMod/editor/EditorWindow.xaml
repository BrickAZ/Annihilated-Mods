<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="勇者小队全灭了 · 贴图编辑器" Width="1150" Height="800"
        MinWidth="940" MinHeight="710" WindowStartupLocation="CenterScreen"
        Background="#141917" Foreground="#EEF1E8" FontFamily="Microsoft YaHei UI"
        FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1C231F"/>
        <SolidColorBrush x:Key="Edge" Color="#37433B"/>
        <SolidColorBrush x:Key="Text" Color="#EEF1E8"/>
        <SolidColorBrush x:Key="Muted" Color="#AFBDB2"/>
        <SolidColorBrush x:Key="Accent" Color="#D3F585"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#202823"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#EEF1E8"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B542D"/>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"
                      Viewbox="0,0,24,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#18201C" Geometry="M0,0 L24,0 24,24 0,24 Z"/>
                    <GeometryDrawing Brush="#212B25" Geometry="M0,0 L12,0 12,12 0,12 Z M12,12 L24,12 24,24 12,24 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#253029"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#97B589"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#1A2610"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#151C18"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#324637"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#35482D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatePicker" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="PickerChrome" Background="#253029" BorderBrush="{StaticResource Edge}"
                                                BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="▾" Foreground="{StaticResource Muted}" Margin="0,0,10,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PickerChrome" Property="BorderBrush" Value="#97B589"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,27,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#202823" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                        CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" Margin="0,0,0,1"
                                Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#2A382F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#35482D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Row" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#141917" Padding="26,20,26,15">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,19">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="贴图编辑器" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="勇者小队全灭了" Foreground="{StaticResource Muted}" Margin="1,1,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="游戏目录" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="RootPath" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           FontFamily="Consolas, Microsoft YaHei UI"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="ChooseRoot" VerticalAlignment="Center" Content="更改目录"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition Width="19"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="8" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Rows="1" Columns="2">
                        <Button x:Name="Enemies" Content="怪物立绘" Margin="0,0,4,0"/>
                        <Button x:Name="Items" Content="物品图标" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBox x:Name="Search" AutomationProperties.Name="搜索资源"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索名称、资源名或状态"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"
                                   Foreground="{StaticResource Muted}" FontSize="12"/>
                    </Grid>
                    <DockPanel Grid.Row="2" Margin="1,10,1,10">
                        <TextBlock x:Name="Count" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <CheckBox x:Name="OnlyReplaced" Content="仅有替换图" FontSize="12"/>
                    </DockPanel>
                    <Grid Grid.Row="3">
                        <ListBox x:Name="Assets" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="资源列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Details}" Margin="0,3,0,0" FontSize="11"
                                                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Mark}" Foreground="{StaticResource Accent}"
                                                   Margin="6,1,0,0" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyList" Text="没有匹配的资源" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="AssetTitle" FontSize="24" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AssetId" Foreground="{StaticResource Muted}" Margin="1,3,0,0"
                                   FontFamily="Consolas, Microsoft YaHei UI" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="AssetSize" Grid.Column="1" Foreground="{StaticResource Accent}"
                               FontFamily="Consolas, Microsoft YaHei UI" FontSize="16" VerticalAlignment="Bottom"
                               Margin="12,0,1,2"/>
                </Grid>

                <DockPanel x:Name="VariantBar" Grid.Row="1" Margin="1,0,1,12">
                    <TextBlock Text="状态 / 形态" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                               Margin="0,0,10,0" DockPanel.Dock="Left"/>
                    <ComboBox x:Name="Variants" Height="29" DisplayMemberPath="Label"
                              Style="{StaticResource StatePicker}" MaxDropDownHeight="310" AutomationProperties.Name="状态或形态"/>
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Edge}">
                        <Grid Margin="11">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="3,0,0,10">
                                <Button x:Name="ExportOriginal" Content="导出原图" DockPanel.Dock="Right" Padding="9,2" MinHeight="26"/>
                                <TextBlock Text="原版贴图" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Border Grid.Row="1" Background="{StaticResource Checker}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid Margin="10">
                                    <Image x:Name="Original" Stretch="Uniform"/>
                                    <TextBlock x:Name="OriginalHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Edge}">
                        <Grid Margin="11">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="3,0,0,10">
                                <TextBlock x:Name="PreviewState" DockPanel.Dock="Right" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                                <TextBlock x:Name="PreviewTitle" Text="当前替换图" VerticalAlignment="Center"
                                           MinHeight="26" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Border x:Name="DropTarget" Grid.Row="1" Background="{StaticResource Checker}"
                                    BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4" AllowDrop="True">
                                <Grid Margin="10">
                                    <Image x:Name="Replacement" Stretch="Uniform"/>
                                    <TextBlock x:Name="ReplacementHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="FrameBar" Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                        BorderThickness="1" CornerRadius="8" Margin="0,12,0,0" Padding="11,7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Margin="2,0,13,0" VerticalAlignment="Center">
                            <TextBlock Text="帧" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FrameCount" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <ListBox x:Name="Frames" Background="Transparent" Foreground="{StaticResource Text}"
                                 BorderThickness="0" Height="64" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="帧列表">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="42">
                                        <Border Background="{StaticResource Checker}" CornerRadius="2">
                                            <Image Source="{Binding Image}" Stretch="Uniform" Width="40" Height="32"/>
                                        </Border>
                                        <TextBlock Text="{Binding Number}" Margin="0,2,0,0" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Text}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        CornerRadius="8" Margin="0,14,0,0" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <WrapPanel>
                                <Button x:Name="ChoosePng" Content="选择 PNG…" Margin="0,0,7,3"/>
                                <Button x:Name="ChooseAll" Content="替换全部帧…" Margin="0,0,9,3"/>
                                <CheckBox x:Name="Fit" Content="自动适配尺寸" IsChecked="True"/>
                            </WrapPanel>
                            <TextBlock x:Name="ImageNote" Margin="1,7,0,0" Foreground="{StaticResource Muted}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="Restore" Content="恢复原图" Margin="0,0,8,0"/>
                            <Button x:Name="Apply" Content="应用替换" Style="{StaticResource Primary}" MinWidth="105"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="1,12,1,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="ModState" Margin="13,0,0,0" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="InstallMod" Content="安装 / 重试" Margin="8,0,0,0"
                    AutomationProperties.Name="安装或重试安装换皮 Mod"
                    MinHeight="26" Padding="8,3" Visibility="Collapsed"/>
        </Grid>
    </Grid>
    </Border>
</Window>
