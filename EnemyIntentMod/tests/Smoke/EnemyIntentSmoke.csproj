<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)../../../..</GameRoot>
    <InteropDir>$(GameRoot)/MelonLoader/Il2CppAssemblies</InteropDir>
    <LoaderDir>$(GameRoot)/MelonLoader/net6</LoaderDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(LoaderDir)/MelonLoader.dll;$(LoaderDir)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(InteropDir)/Il2Cppmscorlib.dll;$(InteropDir)/Assembly-CSharp.dll;$(InteropDir)/Il2CppElringus.Naninovel.Runtime.dll;$(InteropDir)/UnityEngine.CoreModule.dll;$(InteropDir)/Unity.TextMeshPro.dll;$(InteropDir)/UnityEngine.UI.dll;$(InteropDir)/UnityEngine.UIModule.dll" Private="false" />
  </ItemGroup>
</Project>
