<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)..</GameRoot>
    <InteropDir>$(GameRoot)/MelonLoader/Il2CppAssemblies</InteropDir>
    <LoaderDir>$(GameRoot)/MelonLoader/net6</LoaderDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="GalleryCatalog.json" LogicalName="AnnihilatedGallery.Catalog" />
    <EmbeddedResource Include="ReplayCatalog.json" LogicalName="AnnihilatedGallery.Replays" />
    <EmbeddedResource Include="StoryCgMarks.json" LogicalName="AnnihilatedGallery.StoryCgMarks" />
    <EmbeddedResource Include="GalleryCoordinates.26705080.json" LogicalName="AnnihilatedGallery.Coordinates.26705080" />
    <Reference Include="MelonLoader" HintPath="$(LoaderDir)/MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(LoaderDir)/0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(LoaderDir)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(InteropDir)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppElringus.Naninovel.Runtime" HintPath="$(InteropDir)/Il2CppElringus.Naninovel.Runtime.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(InteropDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(InteropDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(InteropDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(InteropDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(InteropDir)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(InteropDir)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(InteropDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(InteropDir)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.Addressables" HintPath="$(InteropDir)/Unity.Addressables.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(InteropDir)/Unity.ResourceManager.dll" Private="false" />
  </ItemGroup>
</Project>
